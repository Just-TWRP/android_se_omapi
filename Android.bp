cc_binary {
    name: "se_omapi",
    srcs: [
        "main.cpp",
        "Channel.cpp",
        "Reader.cpp",
        "Service.cpp",
        "Session.cpp",
        "Terminal.cpp",
        "internal/ByteArrayConverter.cpp",
    ],
    // This hex value is fetched from /vendor/etc/hal_uuid_map.xml
    cflags: select(soong_config_variable("omapi", "uuid"), {
        any @ uuid: ["-DUUID_HEXSTRING=\"" + uuid + "\""],
        default: ["-DUUID_HEXSTRING=\"534552454144595f48414c5f55554944\""], // STM
    }),
    local_include_dirs: ["include"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libutils",
        "android.hardware.secure_element-V1-ndk",
        "android.se.omapi-V1-ndk",
    ],
    recovery_available: true,
}
